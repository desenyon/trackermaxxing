{
  "name": "trackermaxxing",
  "version": "0.4.0",
  "description": "A fast terminal dashboard for your Codex, Claude, Cursor, and GitHub activity.",
  "type": "module",
  "bin": {
    "trackermaxxing": "./dist/cli.js",
    "tmaxing": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsup",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "db:purge-demo": "tsx scripts/purge-demo.ts",
    "daemon": "tsx scripts/worker.ts"
  },
  "private": true,
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "boxen": "^8.0.1",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "drizzle-orm": "^0.45.2",
    "figlet": "^1.11.1",
    "gradient-string": "^3.0.0",
    "ink": "^7.1.0",
    "node-cron": "^4.6.0",
    "react": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/figlet": "^1.7.0",
    "@types/node": "^26.1.1",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.2.17",
    "@vitest/coverage-v8": "^4.1.6",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.1.6"
  }
}
