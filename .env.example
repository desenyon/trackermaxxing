# Local cache lives at ~/.trackermaxxing/data.db by default. Override if you want it elsewhere.
# DATABASE_PATH=~/.trackermaxxing/data.db

# Optional: override the auto-generated local encryption key used to store
# `trackermaxxing github login` credentials at rest.
# TRACKER_ENCRYPTION_KEY=

CODEX_HOME=~/.codex
CODEX_AUTH_PATH=~/.codex/auth.json
# CURSOR_HOME=~/.cursor
# CURSOR_STATE_DB=~/Library/Application Support/Cursor/User/globalStorage/state.vscdb

# GitHub token (repo, read:user scopes) - or run `trackermaxxing github login` instead.
# GITHUB_TOKEN=
# GITHUB_LOGIN=

# Cron schedule for `npm run daemon` (optional background sync).
SYNC_CRON=0 2 * * *
